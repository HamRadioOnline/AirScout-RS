# Shared by the nFPM package and makepkg recipes (install=arch-install).
post_install() {
    systemd-sysusers airscout-planeserver.conf || return
    systemctl preset airscout-planeserver.service || true
}

post_upgrade() {
    systemd-sysusers airscout-planeserver.conf
}

pre_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl stop airscout-planeserver.service || true
    fi
    systemctl disable airscout-planeserver.service || true
}
