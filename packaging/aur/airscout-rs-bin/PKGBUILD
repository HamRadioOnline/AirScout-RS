sha256sums_armv7h=('SKIP')
source_i686=("AirScout-RS-v${pkgver}-linux-i686.pkg.tar.zst::https://github.com/HamRadioOnline/AirScout-RS/releases/download/v${pkgver}/AirScout-RS-v${pkgver}-linux-i686.pkg.tar.zst")
sha256sums_i686=('SKIP')

package() {
    cp -a "${srcdir}/usr" "${pkgdir}/"
    cp -a "${srcdir}/etc" "${pkgdir}/"
}
